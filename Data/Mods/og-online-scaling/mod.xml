<?xml version="1.0" encoding="UTF-8"?>
<Mod>
    <Id>og-online-scaling</Id>
    <Name>Difficulty Scaling</Name>
    <Author>Overgrowth Online</Author>
    <Description>Adjust enemy strength and equipment to the party and its performance. The AI scaling rate also adjusts hostile fighters in compatible versions of Overhaul, Dynamic AI Aggression and Smarter Deaths when installed. The host selects rates in Difficulty. Peers match the active mods and their network schemas. Session saves preserve settings and encounter pressure.</Description>
    <Category>Gameplay</Category>
    <Thumbnail>Data/Images/og-online-scaling.jpg</Thumbnail>
    <Version>1.1.0</Version>
    <SupportedVersion>0.41.36</SupportedVersion>
    <EnabledByDefault>true</EnabledByDefault>
    <SupportsOnline>true</SupportsOnline>
    <NeedsRestart>false</NeedsRestart>
    <LevelHookFile>Data/Scripts/scaling_ai_adapters.as</LevelHookFile>
    <LevelHookFile>Data/Scripts/scaling_overhaul_xp.as</LevelHookFile>
    <Session feature="scaling" network_version="2" save_version="1">
        <OnlineAdapter mod="crxhvrd-overhaul" version="0.41.36"/>
        <OnlineAdapter mod="com-dynamicai" version="1.5.1"/>
        <OnlineAdapter mod="seans-smarter-deaths" version="1.2.5" host_level_hooks="true"/>
        <Rule key="five_minute_gain" value="0.05"/>
        <Rule key="completion_gain" value="0.08"/>
        <Rule key="win_gain" value="0.04"/>
        <Rule key="wipe_gain" value="0.05"/>
        <Rule key="forced_win_gain" value="0.08"/>
        <Rule key="retry_relief" value="0.025"/>
        <LobbySetting key="challenge_time" label="Active time" description="Increase enemy difficulty as active play time passes." default="2" live="true" placement="difficulty">
            <Choice>Off</Choice>
            <Choice>Gentle</Choice>
            <Choice>Standard</Choice>
            <Choice>Brisk</Choice>
            <Choice>Nightmare</Choice>
        </LobbySetting>
        <LobbySetting key="challenge_round" label="Level or match completion" description="Increase enemy difficulty when a level or match is completed." default="2" live="true" placement="difficulty" modes="campaign,arena">
            <Choice>Off</Choice>
            <Choice>Gentle</Choice>
            <Choice>Standard</Choice>
            <Choice>Brisk</Choice>
            <Choice>Nightmare</Choice>
        </LobbySetting>
        <LobbySetting key="challenge_performance" label="Performance scaling" description="Adjust difficulty after wins, party wipes or both." default="0" live="true" placement="difficulty">
            <Choice>Off</Choice>
            <Choice>On win</Choice>
            <Choice>On loss</Choice>
            <Choice>Forced-50</Choice>
        </LobbySetting>
        <LobbySetting key="challenge_performance_rate" label="Performance rate" description="Set the size of each performance adjustment." default="2" live="true" placement="difficulty" depends_on="challenge_performance">
            <Choice>Off</Choice>
            <Choice>Gentle</Choice>
            <Choice>Standard</Choice>
            <Choice>Brisk</Choice>
            <Choice>Nightmare</Choice>
        </LobbySetting>
    </Session>
</Mod>
